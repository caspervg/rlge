# Simple dark raygui style for the demo (text format, loaded by GuiLoadStyle)
# p <control_id> <property_id> <value_hex>
p 0 0 0x3a3a3aff      # DEFAULT: BORDER_COLOR_NORMAL
p 0 1 0x1e1e1eff      # DEFAULT: BASE_COLOR_NORMAL
p 0 2 0xe0e0e0ff      # DEFAULT: TEXT_COLOR_NORMAL
p 0 3 0x5e81acff      # DEFAULT: BORDER_COLOR_FOCUSED
p 0 4 0x2e3440ff      # DEFAULT: BASE_COLOR_FOCUSED
p 0 5 0xffffffff      # DEFAULT: TEXT_COLOR_FOCUSED
p 0 6 0x81a1c1ff      # DEFAULT: BORDER_COLOR_PRESSED
p 0 7 0x3b4252ff      # DEFAULT: BASE_COLOR_PRESSED
p 0 8 0xffffffff      # DEFAULT: TEXT_COLOR_PRESSED
p 0 9 0x404040ff      # DEFAULT: BORDER_COLOR_DISABLED
p 0 10 0x2b2b2bff     # DEFAULT: BASE_COLOR_DISABLED
p 0 11 0x666666ff     # DEFAULT: TEXT_COLOR_DISABLED
p 0 12 0x00000001     # DEFAULT: BORDER_WIDTH
p 0 13 0x00000004     # DEFAULT: TEXT_PADDING
p 0 14 0x00000000     # DEFAULT: TEXT_ALIGNMENT (left)
# Extended/global properties
p 0 16 0x00000012     # DEFAULT: TEXT_SIZE (18)
p 0 17 0x00000001     # DEFAULT: TEXT_SPACING
p 0 18 0x5e81acff     # DEFAULT: LINE_COLOR
p 0 19 0x101014ff     # DEFAULT: BACKGROUND_COLOR
p 0 20 0x00000000     # DEFAULT: TEXT_LINE_SPACING
p 0 21 0x00000000     # DEFAULT: TEXT_ALIGNMENT_VERTICAL (top)
